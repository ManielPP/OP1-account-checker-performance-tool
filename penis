local function loadDB()
    if typeof(isfile) == "function" and typeof(readfile) == "function" then
        local ok, exists = pcall(isfile, DB_FILE)
        if ok and exists then
            local ok2, raw = pcall(readfile, DB_FILE)
            if ok2 and raw and raw ~= "" then
                local ok3, decoded = pcall(function()
                    return HttpService:JSONDecode(raw)
                end)
                if ok3 and type(decoded) == "table" then
                    DB = decoded
                end
            end
        end
    end
end

local function saveDB()
    if typeof(writefile) == "function" then
        pcall(function()
            writefile(DB_FILE, HttpService:JSONEncode(DB))
        end)
    end
end

