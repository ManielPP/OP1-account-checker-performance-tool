local FPS_KEYWORDS = {
    "arsenal", "phantom forces", "frontlines", "bad business", "counter blox",
    "aimblox", "rivals", "operation one", "deadline", "rolling thunder",
    "gunfight", "headshot", "marksman", "sniper", "shooter", "fps",
    "firearm", "weapon", "killstreak", "elimination"
}

local function containsFPSKeyword(text)
    text = safeLower(text)
    for _, keyword in ipairs(FPS_KEYWORDS) do
        if string.find(text, keyword, 1, true) then
            return keyword
        end
    end
    return nil
end

local function isoToUnix(iso)
    if not iso or iso == "" then return nil end
    local ok, dt = pcall(function()
        return DateTime.fromIsoDate(iso)
    end)
    if ok and dt then return dt.UnixTimestamp end
    return nil
end

local function ageDaysFromCreated(created)
    local unix = isoToUnix(created)
    if not unix then return nil end
    return math.max(0, math.floor((DateTime.now().UnixTimestamp - unix) / 86400))
end

local function getUserIdFromUsername(username)
    local ok, id = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if ok then return id end
    return nil
end

local function getUserInfo(userId)
    return getJSON("https://users.roblox.com/v1/users/" .. tostring(userId))
end

local function getFriendCount(userId)
    local data = getJSON("https://friends.roblox.com/v1/users/" .. tostring(userId) .. "/friends/count")
    return data and tonumber(data.count) or nil
end

local function getCurrentlyWearing(userId)
    local data = getJSON("https://avatar.roblox.com/v1/users/" .. tostring(userId) .. "/currently-wearing")
    if data and type(data.assetIds) == "table" then
        return #data.assetIds, data.assetIds
    end
    return nil, nil
end

local function getGroups(userId)
    -- Legacy public endpoint; wrapped so scanner survives if Roblox removes/blocks it.
    local data = getJSON("https://groups.roblox.com/v1/users/" .. tostring(userId) .. "/groups/roles")
    if data and type(data.data) == "table" then
        return #data.data, data.data
    end
    return nil, nil
end

local function getBadges(userId, maxPages)
    maxPages = maxPages or 3
    local out = {}
    local cursor = nil
    local page = 0
    local capped = false
    local available = false

    repeat
        page += 1
        local url = "https://badges.roblox.com/v1/users/" .. tostring(userId) .. "/badges?limit=100&sortOrder=Asc"
        if cursor then
            url ..= "&cursor=" .. HttpService:UrlEncode(cursor)
        end
        local data = getJSON(url)
        if not data or type(data.data) ~= "table" then
            break
        end
        available = true
        for _, badge in ipairs(data.data) do
            out[#out + 1] = badge
        end
        cursor = data.nextPageCursor
        if cursor and page >= maxPages then
            capped = true
            break
        end
    until not cursor

    return out, capped, available
end

local function getThumbnail(userId)
    local ok, content = pcall(function()
        local image, _ = Players:GetUserThumbnailAsync(
            userId,
            Enum.ThumbnailType.HeadShot,
            Enum.ThumbnailSize.Size180x180
        )
        return image
    end)
    if ok then return content end
    return ""
end

local function analyzeAccount(info, friendCount, badgeList, badgeCapped, badgeAvailable, groupCount, assetCount)
    local signals = {}
    local risk = 0
    local alt = 0
    local ageDays = ageDaysFromCreated(info and info.created)
    local username = info and info.name or "?"
    local display = info and info.displayName or username
    local description = trim(info and info.description or "")
    local customDisplay = safeLower(display) ~= safeLower(username)
    local badgeCount = #badgeList

    local fpsHits = 0
    local fpsKinds = {}
    local fpsNames = {}

    for _, badge in ipairs(badgeList) do
        local hay = tostring(badge.name or "") .. " " .. tostring(badge.description or "")
        local hit = containsFPSKeyword(hay)
        if hit then
            fpsHits += 1
            fpsKinds[hit] = true
            if #fpsNames < 6 then
                fpsNames[#fpsNames + 1] = tostring(badge.name or "Unnamed badge")
            end
        end
    end

    local fpsDiversity = 0
    for _ in pairs(fpsKinds) do fpsDiversity += 1 end

    if ageDays then
        if ageDays < 30 then
            risk += 30; alt += 38
            signals[#signals + 1] = "Very new account (<30 days)"
        elseif ageDays < 110 then
            risk += 22; alt += 30
            signals[#signals + 1] = "New account (<110 days)"
        elseif ageDays < 365 then
            risk += 8; alt += 12
            signals[#signals + 1] = "Account under 1 year old"
        end
    end

    if friendCount ~= nil then
        if friendCount <= 5 then
            risk += 16; alt += 22
            signals[#signals + 1] = "Very low friend count (" .. friendCount .. ")"
        elseif friendCount <= 15 then
            risk += 8; alt += 10
            signals[#signals + 1] = "Low friend count (" .. friendCount .. ")"
        end
    end

    if not customDisplay then
        if ageDays and ageDays < 365 then
            risk += 8; alt += 10
            signals[#signals + 1] = "Newer account with no custom display name"
        else
            alt += 3
        end
    end

    if assetCount ~= nil then
        if assetCount <= 4 then
            risk += 8; alt += 15
            signals[#signals + 1] = "Very basic avatar asset count (" .. assetCount .. ")"
        elseif assetCount <= 6 then
            alt += 7
            signals[#signals + 1] = "Basic avatar asset count (" .. assetCount .. ")"
        end
    end

    if description == "" then
        alt += 4
    end

    if badgeAvailable then
        if badgeCount < 10 then
            risk += 12; alt += 15
            signals[#signals + 1] = "Very few visible badges (" .. badgeCount .. ")"
        elseif badgeCount < 30 then
            risk += 6; alt += 7
            signals[#signals + 1] = "Few visible badges (" .. badgeCount .. ")"
        end
    else
        signals[#signals + 1] = "Badge list unavailable/private — not scored"
    end

    if ageDays and ageDays > 1000 then
        local sparse = 0
        if friendCount and friendCount <= 5 then sparse += 1 end
        if badgeAvailable and badgeCount < 20 then sparse += 1 end
        if assetCount and assetCount <= 5 then sparse += 1 end
        if description == "" then sparse += 1 end
        if sparse >= 3 then
            risk += 10; alt += 25
            signals[#signals + 1] = "Old account but unusually sparse/fresh profile"
        end
    end

    if badgeAvailable then
        if fpsHits > 0 then
            signals[#signals + 1] = "FPS/shooter badge hits: " .. fpsHits .. " (diversity " .. fpsDiversity .. ")"
            if fpsDiversity >= 4 then
                alt -= 8
            elseif fpsDiversity >= 2 then
                alt -= 4
            end
        elseif ageDays and ageDays < 365 and badgeCount < 30 then
            risk += 4
            signals[#signals + 1] = "Little visible shooter badge history"
        end
    end

    if groupCount ~= nil and groupCount == 0 and ageDays and ageDays < 365 then
        alt += 3
    end

    risk = clamp(math.floor(risk), 0, 100)
    alt = clamp(math.floor(alt), 0, 100)

    local verdict
    if risk >= 75 then
        verdict = "HIGH SUSPICION"
    elseif risk >= 50 then
        verdict = "SUSPICIOUS PROFILE"
    elseif risk >= 25 then
        verdict = "NOT SURE"
    else
        verdict = "LOW SIGNAL"
    end

    return {
        risk = risk,
        alt = alt,
        verdict = verdict,
        ageDays = ageDays,
        badgeCount = badgeCount,
        badgeCapped = badgeCapped,
        badgeAvailable = badgeAvailable,
        fpsHits = fpsHits,
        fpsDiversity = fpsDiversity,
        fpsNames = fpsNames,
        signals = signals,
        customDisplay = customDisplay,
    }
end

local function scanById(userId)
    local info = getUserInfo(userId)
    if not info then
        return nil, "Could not fetch public user info"
    end

    local friendCount = getFriendCount(userId)
    local assetCount = getCurrentlyWearing(userId)
    local groupCount = getGroups(userId)
    local badges, badgeCapped, badgeAvailable = getBadges(userId, 3)
    local analysis = analyzeAccount(info, friendCount, badges, badgeCapped, badgeAvailable, groupCount, assetCount)

    return {
        userId = userId,
        info = info,
        friendCount = friendCount,
        assetCount = assetCount,
        groupCount = groupCount,
        badges = badges,
        analysis = analysis,
        thumbnail = getThumbnail(userId),
    }
end

