local SCANNING = false

local function parseNames(text)
    local out, seen = {}, {}
    for token in string.gmatch(text or "", "[^,%s]+") do
        token = trim(token)
        local low = safeLower(token)
        if token ~= "" and not seen[low] then
            seen[low] = true
            out[#out + 1] = token
            if #out >= 8 then break end
        end
    end
    return out
end

local function setScanBusy(on, text)
    statusDot.BackgroundColor3 = on and COLORS.yellow or COLORS.green
    scanButton.Text = on and "SCANNING..." or "SCAN"
    scanButton.Active = not on
    if text then scanStatus.Text = text end
end

local function runUsernameScan(names)
    if SCANNING then return end
    SCANNING = true
    clearResults()

    if #names == 0 then
        setScanBusy(false, "Enter at least one username.")
        showToast("Enter a username first", COLORS.yellow)
        SCANNING = false
        return
    end

    setScanBusy(true, "Starting scan...")
    task.spawn(function()
        for i, username in ipairs(names) do
            if UNLOADED then break end
            setScanBusy(true, string.format("Scanning %s  •  %d/%d", username, i, #names))
            local userId = getUserIdFromUsername(username)
            if not userId then
                addErrorCard(username, "Username not found")
            else
                local data, err = scanById(userId)
                if data then addResultCard(data) else addErrorCard(username, err or "Scan failed") end
            end
            task.wait(0.12)
        end
        setScanBusy(false, "Finished • tags save locally when file APIs are supported")
        showToast("Scan finished", COLORS.green)
        SCANNING = false
    end)
end

track(scanButton.MouseButton1Click:Connect(function()
    runUsernameScan(parseNames(input.Text))
end))

track(input.FocusLost:Connect(function(enterPressed)
    if enterPressed then runUsernameScan(parseNames(input.Text)) end
end))

track(lobbyButton.MouseButton1Click:Connect(function()
    if SCANNING then return end
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            names[#names + 1] = plr.Name
            if #names >= 8 then break end
        end
    end
    if #names == 0 then names[1] = LocalPlayer.Name end
    input.Text = table.concat(names, ", ")
    showToast("Loaded lobby usernames", COLORS.purple)
    runUsernameScan(names)
end))

