local function clamp(n, lo, hi)
    return math.max(lo, math.min(hi, n))
end

local function trim(s)
    return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function safeLower(s)
    return string.lower(tostring(s or ""))
end

