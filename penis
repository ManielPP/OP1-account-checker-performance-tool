local REQUEST = nil
pcall(function()
    if syn and syn.request then REQUEST = syn.request end
end)
if not REQUEST and typeof(http_request) == "function" then REQUEST = http_request end
if not REQUEST and typeof(request) == "function" then REQUEST = request end

local function rawGet(url)
    if REQUEST then
        local ok, response = pcall(function()
            return REQUEST({
                Url = url,
                Method = "GET",
                Headers = { ["User-Agent"] = "OP1Checker" }
            })
        end)
        if ok and response then
            local body = response.Body or response.body
            local code = response.StatusCode or response.Status or response.status
            if body and (not code or (code >= 200 and code < 300)) then
                return body
            end
        end
    end

    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok then return body end
    return nil
end

local function getJSON(url)
    local body = rawGet(url)
    if not body then return nil end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if ok then return decoded end
    return nil
end

