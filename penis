local PERF = {
    Textures = false,
    Materials = false,
    Particles = false,
    Shadows = false,
    PostFX = false,
    Atmosphere = false,
    Potato = false,
    FPSCap = false,
}

local PCACHE = {
    Textures = {},
    Materials = {},
    Particles = {},
    Shadows = {},
    PostFX = {},
    Atmosphere = {},
}

local function safeGet(obj, prop)
    local ok, v = pcall(function() return obj[prop] end)
    if ok then return v end
end

local function safeSet(obj, prop, value)
    pcall(function() obj[prop] = value end)
end

local function remember(cache, obj, prop)
    if not cache[obj] then cache[obj] = {} end
    if cache[obj][prop] == nil then cache[obj][prop] = safeGet(obj, prop) end
end

local function change(cache, obj, prop, value)
    remember(cache, obj, prop)
    safeSet(obj, prop, value)
end

local function restoreCache(cache)
    for obj, props in pairs(cache) do
        for prop, value in pairs(props) do
            if value ~= nil then safeSet(obj, prop, value) end
        end
    end
    table.clear(cache)
end

local function stripTextureObject(obj)
    if obj:IsA("Decal") or obj:IsA("Texture") then
        change(PCACHE.Textures, obj, "Transparency", 1)
    elseif obj:IsA("MeshPart") then
        change(PCACHE.Textures, obj, "TextureID", "")
    elseif obj:IsA("SpecialMesh") then
        change(PCACHE.Textures, obj, "TextureId", "")
    elseif obj:IsA("SurfaceAppearance") then
        change(PCACHE.Textures, obj, "ColorMap", "")
        change(PCACHE.Textures, obj, "NormalMap", "")
        change(PCACHE.Textures, obj, "RoughnessMap", "")
        change(PCACHE.Textures, obj, "MetalnessMap", "")
    end
end

local function stripMaterialObject(obj)
    if obj:IsA("BasePart") then
        change(PCACHE.Materials, obj, "Material", Enum.Material.SmoothPlastic)
        change(PCACHE.Materials, obj, "Reflectance", 0)
    end
end

local particleTypes = {
    ParticleEmitter = true, Trail = true, Beam = true,
    Smoke = true, Fire = true, Sparkles = true,
}

local function stripParticleObject(obj)
    if particleTypes[obj.ClassName] then
        change(PCACHE.Particles, obj, "Enabled", false)
    end
end

local function stripShadowObject(obj)
    if obj:IsA("BasePart") then
        change(PCACHE.Shadows, obj, "CastShadow", false)
    end
end

local function stripPostObject(obj)
    if obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("ColorCorrectionEffect")
        or obj:IsA("DepthOfFieldEffect") or obj:IsA("SunRaysEffect") then
        change(PCACHE.PostFX, obj, "Enabled", false)
    end
end

local function stripAtmosObject(obj)
    if obj:IsA("Atmosphere") then
        change(PCACHE.Atmosphere, obj, "Density", 0)
        change(PCACHE.Atmosphere, obj, "Haze", 0)
    elseif obj:IsA("Clouds") then
        change(PCACHE.Atmosphere, obj, "Coverage", 0)
        change(PCACHE.Atmosphere, obj, "Density", 0)
    end
end

local function setTextures(on)
    PERF.Textures = on
    if on then
        for _, obj in ipairs(workspace:GetDescendants()) do stripTextureObject(obj) end
    else
        restoreCache(PCACHE.Textures)
    end
end

local function setMaterials(on)
    PERF.Materials = on
    if on then
        for _, obj in ipairs(workspace:GetDescendants()) do stripMaterialObject(obj) end
    else
        restoreCache(PCACHE.Materials)
    end
end

local function setParticles(on)
    PERF.Particles = on
    if on then
        for _, obj in ipairs(workspace:GetDescendants()) do stripParticleObject(obj) end
    else
        restoreCache(PCACHE.Particles)
    end
end

local function setShadows(on)
    PERF.Shadows = on
    if on then
        change(PCACHE.Shadows, Lighting, "GlobalShadows", false)
        for _, obj in ipairs(workspace:GetDescendants()) do stripShadowObject(obj) end
    else
        restoreCache(PCACHE.Shadows)
    end
end

local function setPostFX(on)
    PERF.PostFX = on
    if on then
        for _, obj in ipairs(Lighting:GetDescendants()) do stripPostObject(obj) end
    else
        restoreCache(PCACHE.PostFX)
    end
end

local function setAtmosphere(on)
    PERF.Atmosphere = on
    if on then
        for _, obj in ipairs(Lighting:GetDescendants()) do stripAtmosObject(obj) end
        for _, obj in ipairs(workspace:GetDescendants()) do stripAtmosObject(obj) end
    else
        restoreCache(PCACHE.Atmosphere)
    end
end

local function setPotato(on)
    PERF.Potato = on
    setTextures(on)
    setMaterials(on)
    setParticles(on)
    setShadows(on)
    setPostFX(on)
    setAtmosphere(on)
end

local function setFPSCap(on)
    if on then
        if typeof(setfpscap) == "function" then
            local ok = pcall(function() setfpscap(9999) end)
            PERF.FPSCap = ok
            return ok
        end
        PERF.FPSCap = false
        return false
    else
        if typeof(setfpscap) == "function" then
            pcall(function() setfpscap(240) end)
        end
        PERF.FPSCap = false
        return true
    end
end

local function restorePerformance()
    PERF.Potato = false
    PERF.Textures = false
    PERF.Materials = false
    PERF.Particles = false
    PERF.Shadows = false
    PERF.PostFX = false
    PERF.Atmosphere = false
    restoreCache(PCACHE.Textures)
    restoreCache(PCACHE.Materials)
    restoreCache(PCACHE.Particles)
    restoreCache(PCACHE.Shadows)
    restoreCache(PCACHE.PostFX)
    restoreCache(PCACHE.Atmosphere)
end

